<?xml version="1.0" encoding="utf-8"?>
<!--
    TNPD Prison Role Master Seed Data
    Source of truth: Post Detail PDF + role_vacancy_clean.csv
    Standardization rules:
        Jailor / Jailer (Men)  → "Jailer"      gender_type=men
        Deputy Jailor          → "Deputy Jailer" gender_type=men
        Assistant Jailor       → "Assistant Jailer" gender_type=men
        *Women variants        → gender_type=women
        Administrative/other   → gender_type=both
-->
<odoo noupdate="1">

    <!-- ── Core Men Warder / Jailer Roles ───────────────────────────────── -->
    <record id="role_jailer" model="prison.role">
        <field name="name">Jailer</field>
        <field name="gender_type">men</field>
        <field name="sequence">1</field>
    </record>
    <record id="role_deputy_jailer" model="prison.role">
        <field name="name">Deputy Jailer</field>
        <field name="gender_type">men</field>
        <field name="sequence">2</field>
