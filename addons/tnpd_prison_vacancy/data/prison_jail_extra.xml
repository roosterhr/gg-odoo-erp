<?xml version="1.0" encoding="utf-8"?>
<!--
    Additional prison.jail records required for vacancy tracking.
    noupdate="0" — applied on every module upgrade to keep DEV/PROD in sync.

    Includes:
    - Special Prisons for Women / SPW (5 standalone facilities, hierarchy_type=women)
    - Women-specific sub-jails (women_sub_jail type)
    - Special Sub Jails (special_sub_jail type)
    - Open Air / Farm / Transit facilities
    - Closed sub-jails (active=False)
-->
<odoo>
<data noupdate="0">

