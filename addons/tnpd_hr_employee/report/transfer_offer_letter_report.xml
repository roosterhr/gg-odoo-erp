<odoo>

    <record id="paperformat_transfer_offer_letter" model="report.paperformat">
        <field name="name">Transfer Offer Letter (A4)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">18</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">25</field>
        <field name="margin_right">20</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Adds Print > Transfer Offer Letter to a transfer order. -->
    <record id="action_report_transfer_offer_letter" model="ir.actions.report">
        <field name="name">Transfer Offer Letter</field>
        <field name="model">transfer.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tnpd_hr_employee.report_transfer_offer_letter</field>
        <field name="report_file">tnpd_hr_employee.report_transfer_offer_letter</field>
        <field name="print_report_name">'Transfer_Order_%s' % ((object.name or 'DRAFT-%s' % object.id).replace('/', '-'))</field>
        <!-- An issued order is a legal document: its PDF is stored the first time it is made
             (at issue) and that file is served from then on, so later changes to an
             employee, a role or a prison name cannot alter a letter already sent. -->
        <field name="attachment">(object.state == 'issued') and ('Transfer_Order_%s.pdf' % object.name.replace('/', '-'))</field>
        <field name="attachment_use" eval="True"/>
        <field name="paperformat_id" ref="paperformat_transfer_offer_letter"/>
        <field name="binding_model_id" ref="model_transfer_order"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
